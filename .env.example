# VLM_PROVIDER selects the vision backend: 'ollama' (default) or 'openai'
# (any OpenAI-compatible /chat/completions server: llama.cpp's llama-server,
# vLLM, LM Studio, etc).
VLM_PROVIDER=ollama

OLLAMA_URL=http://localhost:11434
DOCKER_OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2-vision

# Used when VLM_PROVIDER=openai. DOCKER_OPENAI_BASE_URL is what Compose maps
# into the container (localhost inside a container isn't the host machine).
OPENAI_BASE_URL=http://localhost:8080/v1
DOCKER_OPENAI_BASE_URL=http://host.docker.internal:8080/v1
OPENAI_MODEL=default
OPENAI_API_KEY=none

API_PORT=8000
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=5455
MCP_PATH=/mcp
OUTPUT_DIR=output
BROWSER_TIMEOUT_MS=60000
BROWSER_SETTLE_MS=6000
VIEWPORT_WIDTH=1500
VIEWPORT_HEIGHT=1910
MAX_PROBE_PAGE=2000
PDF_DPI=300
VLM_TIMEOUT_SECONDS=120
